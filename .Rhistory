# Exploratory age effect on perceived administrative efficiency
keep <- complete.cases(cit_scores$V2_eficiencia, ciudadanos$rango_edad)
y <- cit_scores$V2_eficiencia[keep]
g <- droplevels(factor(ciudadanos$rango_edad[keep]))
counts <- table(g)
if (length(counts) < 2 || any(counts < 2)) {
age_efficiency_table <- data.frame(
outcome = "V2_eficiencia",
predictor = "rango_edad",
test = "Not estimable",
F = NA_real_,
p = NA_real_,
df1 = NA_real_,
df2 = NA_real_,
n = length(y),
groups = length(counts)
)
} else {
lev_p <- car::leveneTest(y ~ g)[1, "Pr(>F)"]
if (!is.na(lev_p) && lev_p >= 0.05) {
fit <- aov(y ~ g)
a <- summary(fit)[[1]][1, ]
age_efficiency_table <- data.frame(
outcome = "V2_eficiencia",
predictor = "rango_edad",
test = "One-way ANOVA",
F = unname(a[["F value"]]),
p = unname(a[["Pr(>F)"]]),
df1 = unname(a[["Df"]]),
df2 = unname(a[["Df"]])
)
} else {
fit <- oneway.test(y ~ g, var.equal = FALSE)
age_efficiency_table <- data.frame(
outcome = "V2_eficiencia",
predictor = "rango_edad",
test = "Welch ANOVA",
F = unname(fit$statistic),
p = fit$p.value,
df1 = unname(fit$parameter[1]),
df2 = unname(fit$parameter[2])
)
}
age_efficiency_table$n <- length(y)
age_efficiency_table$groups <- length(counts)
}
age_efficiency_table
