hypothesis$decision[1], ".")
} else {
"La hipótesis principal V3-V2 no fue estimable con los datos disponibles."
}
interpretation_text <- c(
"PREPARACIÓN DE RESULTADOS PARA LA ENTREGA",
"",
"1. Estadísticos descriptivos",
"Se prepararon medidas de tendencia central y dispersión para los puntajes compuestos y para cada ítem. Las variables categóricas se presentan mediante frecuencias y porcentajes válidos.",
"",
"2. Confiabilidad",
"Se estimó alfa de Cronbach para las escalas MD por KPA y global, y para V2, V3 y V4. Las estimaciones actuales deben presentarse como preliminares mientras la muestra sea parcial.",
"",
"3. Hipótesis y pruebas",
"El nivel de significancia es α = .05. La selección de pruebas se basa en normalidad y Levene, y se reportan estadístico, p y tamaño de efecto.",
hypothesis_line,
"Las comparaciones por grupos se consideran exploratorias porque no se definió una hipótesis específica para cada variable sociodemográfica.",
"",
"4. Hallazgos y patrones",
"Los patrones de medias se encuentran en patrones_medias_por_indicador.csv. No deben interpretarse como evidencia causal ni generalizarse fuera de la muestra recolectada.",
"",
"5. Limitaciones",
"La muestra parcial, los grupos pequeños, la ausencia de entrevistas y la falta de una matriz de jueces limitan la fuerza de las conclusiones actuales.",
"",
"6. Componentes pendientes",
"Quedan pendientes el análisis cualitativo, los criterios de credibilidad/transferibilidad/dependencia/confirmabilidad basados en entrevistas y la triangulación mixta final."
)
writeLines(interpretation_text, file.path(ANALYSIS_DIR, "interpretacion_resultados_actuales.txt"), useBytes = TRUE)
quality_pending <- c(
"CALIDAD DEL COMPONENTE CUALITATIVO - PENDIENTE",
"",
"Credibilidad: codificación trazable, casos negativos, revisión de interpretaciones y, si es posible, devolución a participantes.",
"Transferibilidad: descripción densa del contexto municipal, perfiles de participantes y condiciones de recolección.",
"Dependencia: bitácora de decisiones, versiones del código y registro de cambios en categorías.",
"Confirmabilidad: memos reflexivos, separación entre datos y opinión del investigador y evidencia textual de cada tema.",
"Estos criterios no se califican todavía porque no hay transcripciones ni matriz de codificación."
)
writeLines(quality_pending, file.path(ANALYSIS_DIR, "calidad_cualitativa_pendiente.txt"), useBytes = TRUE)
log_message("Tablas de entrega, coherencia, limitaciones y validación metodológica generadas.")
###############################################################################
# GRAFICO DE CONSISTENCIA INTERNA
# Se ejecuta después de calcular el objeto `reliability`.
###############################################################################
alpha_plot <- reliability[is.finite(reliability$alfa), , drop = FALSE]
if (nrow(alpha_plot) > 0) {
alpha_labels <- c(
V1_estrategia = "V1 Estrategia",
V1_participacion = "V1 Participación",
V1_diseno = "V1 Diseño",
V1_transicion = "V1 Transición",
V1_operacion = "V1 Operación",
V1_mejora_continua = "V1 Mejora continua",
V1_global_24_items = "V1 Global (24 ítems)",
V2_eficiencia = "V2 Eficiencia",
V3_digitalizacion = "V3 Digitalización",
V4_satisfaccion = "V4 Satisfacción"
)
labels <- unname(alpha_labels[alpha_plot$escala])
labels[is.na(labels)] <- alpha_plot$escala[is.na(labels)]
order_alpha <- order(alpha_plot$alfa)
values <- alpha_plot$alfa[order_alpha]
labels <- labels[order_alpha]
colours <- cut(values,
breaks = c(-Inf, .60, .70, .80, .90, Inf),
labels = c("#D1495B", "#F4A261", "#E9C46A", "#4C956C", "#2A9D8F"),
right = FALSE)
colours <- as.character(colours)
png(file.path(FIGURE_DIR, "12_confiabilidad_alpha.png"),
width = 2400, height = 1800, res = 160)
par(mar = c(5, 22, 4, 3), las = 1, family = "sans")
bp <- barplot(values, horiz = TRUE, names.arg = labels,
xlim = c(min(0, min(values) - .10), max(1, max(values) + .15)),
col = colours, border = NA, xlab = "Alfa de Cronbach",
main = "Alfa de Cronbach por escala")
abline(v = c(.60, .70, .80, .90), lty = 3, lwd = 1, col = "#777777")
text(values, bp, labels = sprintf("%.2f", values),
pos = ifelse(values >= 0, 4, 2), cex = .9, xpd = NA)
legend("bottomright",
legend = c("Excelente >= .90", "Buena .80-.89", "Aceptable .70-.79",
"Cuestionable .60-.69", "Inaceptable < .60"),
fill = c("#2A9D8F", "#4C956C", "#E9C46A", "#F4A261", "#D1495B"),
border = NA, bty = "n", cex = .9)
dev.off()
}
log_message("Gráfico de confiabilidad generado en: ", FIGURE_DIR)
###############################################################################
# ANALISIS CUANTITATIVO
# Del papel a lo digital: percepción de la madurez digital en los servicios
# municipales de la Municipalidad de Tibás
#
# Entrada: Proyecto_ETL/output/clean/*.csv
# Salida: Proyecto_ETL/output/analysis_quantitative/
#
# Este script sigue el prompt estadístico del profesor y el documento de
# instrumentos. La triangulación cualitativa queda pendiente hasta disponer
# de las transcripciones de entrevistas.
###############################################################################
options(stringsAsFactors = FALSE, scipen = 999, digits = 4)
script_args <- commandArgs(trailingOnly = FALSE)
file_arg <- grep("^--file=", script_args, value = TRUE)
script_dir <- if (length(file_arg) == 1) {
dirname(normalizePath(sub("^--file=", "", file_arg)))
} else {
file.path(getwd(), "R")
}
# Cuando se ejecuta el archivo puente desde DatosExperiencia, script_dir apunta
# al directorio del proyecto; cuando se ejecuta este archivo directamente,
# script_dir apunta a DatosExperiencia/R.
R_DIR <- if (basename(script_dir) == "R") script_dir else file.path(script_dir, "R")
PROJECT_DIR <- normalizePath(
if (basename(script_dir) == "R") file.path(script_dir, "..") else script_dir,
mustWork = TRUE
)
ETL_DIR <- file.path(PROJECT_DIR, "Proyecto_ETL")
CLEAN_DIR <- file.path(ETL_DIR, "output", "clean")
ANALYSIS_DIR <- file.path(ETL_DIR, "output", "analysis_quantitative")
TABLE_DIR <- file.path(ANALYSIS_DIR, "tables")
dir.create(TABLE_DIR, recursive = TRUE, showWarnings = FALSE)
required_packages <- c("psych", "car")
missing_packages <- required_packages[!vapply(required_packages, requireNamespace,
logical(1), quietly = TRUE)]
if (length(missing_packages) > 0) {
stop("Instale antes de ejecutar: ", paste(missing_packages, collapse = ", "))
}
log_file <- file.path(ANALYSIS_DIR, "analysis_log.txt")
log_message <- function(...) {
line <- paste0(format(Sys.time(), "%Y-%m-%d %H:%M:%S"), " | ", paste(..., collapse = ""))
cat(line, "\n")
write(line, log_file, append = TRUE)
}
write_table <- function(x, name) {
write.csv(x, file.path(TABLE_DIR, paste0(name, ".csv")),
row.names = FALSE, na = "", fileEncoding = "UTF-8")
}
read_clean <- function(name) {
path <- file.path(CLEAN_DIR, paste0(name, ".csv"))
if (!file.exists(path)) stop("No existe el CSV limpio: ", path)
read.csv(path, na.strings = c("", "NA", "<NA>"),
check.names = FALSE, stringsAsFactors = FALSE,
fileEncoding = "UTF-8")
}
funcionarios <- read_clean("funcionarios")
ciudadanos <- read_clean("ciudadanos")
documental <- read_clean("documental")
required_columns <- function(data, columns, label) {
missing <- setdiff(columns, names(data))
if (length(missing) > 0) {
stop(label, " no contiene: ", paste(missing, collapse = ", "))
}
}
MD <- sprintf("MD%02d", 1:24)
EA <- sprintf("EA%02d", 1:8)
DGP <- sprintf("DGP%02d", 1:5)
SAT <- sprintf("SAT%02d", 1:5)
RD <- sprintf("RD%02d", 1:8)
required_columns(funcionarios, c(MD, "area", "antiguedad", "relacion_tecnologia"), "Funcionarios")
required_columns(ciudadanos, c(EA, DGP, SAT, "NPS1", "tipo_tramite", "canal",
"frecuencia_uso", "rango_edad"), "Ciudadanos")
required_columns(documental, c(RD, "digital_level", "digital_level_code"), "Documental")
###############################################################################
# Construcción de escalas conforme al instrumento
###############################################################################
scale_definitions <- list(
estrategia = sprintf("MD%02d", 1:4),
participacion = sprintf("MD%02d", 5:8),
diseno = sprintf("MD%02d", 9:12),
transicion = sprintf("MD%02d", 13:16),
operacion = sprintf("MD%02d", 17:20),
mejora_continua = sprintf("MD%02d", 21:24),
V1_global = MD,
V2_eficiencia = EA,
V3_digitalizacion = DGP,
V4_satisfaccion = SAT
)
row_mean_min <- function(data, items, minimum_proportion = 0.50) {
values <- data[, items, drop = FALSE]
values[] <- lapply(values, function(x) suppressWarnings(as.numeric(x)))
answered <- rowSums(!is.na(values))
minimum <- ceiling(length(items) * minimum_proportion)
result <- rowMeans(values, na.rm = TRUE)
result[answered < minimum | is.nan(result)] <- NA_real_
result
}
add_scores <- function(data, definitions) {
out <- data.frame(row.names = seq_len(nrow(data)))
for (name in names(definitions)) {
out[[name]] <- row_mean_min(data, definitions[[name]])
}
out
}
func_scores <- add_scores(funcionarios, scale_definitions[1:7])
cit_scores <- add_scores(ciudadanos, scale_definitions[8:10])
###############################################################################
# Fase 1. Descriptivos
###############################################################################
mode_value <- function(x) {
tab <- table(x)
if (!length(tab)) return(NA_character_)
modes <- names(tab)[tab == max(tab)]
paste(modes, collapse = " / ")
}
safe_describe <- function(data, variables, labels = variables) {
rows <- lapply(seq_along(variables), function(i) {
x <- suppressWarnings(as.numeric(data[[variables[i]]]))
x <- x[is.finite(x)]
if (!length(x)) {
return(data.frame(variable = labels[i], n = 0, media = NA, mediana = NA, moda = NA,
DE = NA, varianza = NA, CV_pct = NA, Q1 = NA, Q3 = NA, IQR = NA,
asimetria = NA, curtosis = NA, minimo = NA, maximo = NA))
}
d <- psych::describe(x)
media <- mean(x)
data.frame(variable = labels[i], n = length(x), media = media,
mediana = median(x), moda = mode_value(x), DE = sd(x),
varianza = var(x), CV_pct = ifelse(media == 0, NA, sd(x) / abs(media) * 100),
Q1 = as.numeric(quantile(x, .25, names = FALSE)),
Q3 = as.numeric(quantile(x, .75, names = FALSE)),
IQR = IQR(x), asimetria = unname(d$skew),
curtosis = unname(d$kurtosis), minimo = min(x), maximo = max(x),
stringsAsFactors = FALSE)
})
do.call(rbind, rows)
}
frequency_table <- function(data, variables, dataset) {
rows <- lapply(variables, function(variable) {
x <- data[[variable]]
x[is.na(x) | trimws(x) == ""] <- NA
counts <- table(x, useNA = "ifany")
denom <- sum(!is.na(x))
data.frame(dataset = dataset, variable = variable,
categoria = names(counts), frecuencia = as.integer(counts),
porcentaje_valido = if (denom) round(as.integer(counts) / denom * 100, 2) else NA,
faltantes = sum(is.na(x)))
})
do.call(rbind, rows)
}
desc_funcionarios <- safe_describe(func_scores,
names(func_scores), names(func_scores))
desc_ciudadanos <- safe_describe(cit_scores,
names(cit_scores), names(cit_scores))
write_table(desc_funcionarios, "descriptivos_funcionarios")
write_table(desc_ciudadanos, "descriptivos_ciudadanos")
freq_funcionarios <- frequency_table(funcionarios,
c("area", "antiguedad", "relacion_tecnologia"),
"funcionarios")
freq_ciudadanos <- frequency_table(ciudadanos,
c("tipo_tramite", "canal", "frecuencia_uso", "rango_edad"),
"ciudadanos")
write_table(freq_funcionarios, "frecuencias_funcionarios")
write_table(freq_ciudadanos, "frecuencias_ciudadanos")
###############################################################################
# Fase 1. Consistencia interna
###############################################################################
alpha_one <- function(data, items, scale_name) {
values <- data[, items, drop = FALSE]
values[] <- lapply(values, function(x) suppressWarnings(as.numeric(x)))
n_complete <- sum(complete.cases(values))
result <- tryCatch(psych::alpha(values, check.keys = FALSE, warnings = FALSE),
error = function(e) NULL)
if (is.null(result)) {
return(data.frame(escala = scale_name, items = length(items),
n_completo = n_complete, alfa = NA,
alfa_estandarizado = NA, interpretacion = "No estimable"))
}
alpha <- unname(result$total$raw_alpha)
interpretation <- if (is.na(alpha)) {
"No estimable"
} else if (alpha >= .90) {
"Excelente (>= .90)"
} else if (alpha >= .80) {
"Buena (.80-.89)"
} else if (alpha >= .70) {
"Aceptable (.70-.79)"
} else if (alpha >= .60) {
"Cuestionable (.60-.69)"
} else {
"Inaceptable (< .60)"
}
data.frame(escala = scale_name, items = length(items), n_completo = n_complete,
alfa = alpha, alfa_estandarizado = unname(result$total$std.alpha),
interpretacion = interpretation)
}
reliability <- rbind(
alpha_one(funcionarios, scale_definitions$estrategia, "V1_estrategia"),
alpha_one(funcionarios, scale_definitions$participacion, "V1_participacion"),
alpha_one(funcionarios, scale_definitions$diseno, "V1_diseno"),
alpha_one(funcionarios, scale_definitions$transicion, "V1_transicion"),
alpha_one(funcionarios, scale_definitions$operacion, "V1_operacion"),
alpha_one(funcionarios, scale_definitions$mejora_continua, "V1_mejora_continua"),
alpha_one(funcionarios, scale_definitions$V1_global, "V1_global_24_items"),
alpha_one(ciudadanos, scale_definitions$V2_eficiencia, "V2_eficiencia"),
alpha_one(ciudadanos, scale_definitions$V3_digitalizacion, "V3_digitalizacion"),
alpha_one(ciudadanos, scale_definitions$V4_satisfaccion, "V4_satisfaccion")
)
reliability$nota_muestra <- ifelse(reliability$n_completo < 30,
"Preliminar: n completo < 30", "")
write_table(reliability, "confiabilidad")
###############################################################################
# Fase 2. Normalidad y homocedasticidad
###############################################################################
normality_one <- function(x, variable, dataset) {
x <- suppressWarnings(as.numeric(x))
x <- x[is.finite(x)]
n <- length(x)
if (n < 3 || sd(x) == 0) {
return(data.frame(dataset = dataset, variable = variable, n = n,
prueba = NA, estadistico = NA, p_value = NA,
decision = "No estimable"))
}
if (n < 50) {
test <- stats::shapiro.test(x)
method <- "Shapiro-Wilk"
} else {
test <- suppressWarnings(stats::ks.test(x, "pnorm", mean(x), sd(x)))
method <- "Kolmogorov-Smirnov"
}
p <- unname(test$p.value)
data.frame(dataset = dataset, variable = variable, n = n, prueba = method,
estadistico = unname(test$statistic), p_value = p,
decision = ifelse(p < .05, "Se rechaza normalidad", "No se rechaza normalidad"))
}
normality <- rbind(
normality_one(func_scores$V1_global, "V1_global", "funcionarios"),
normality_one(cit_scores$V2_eficiencia, "V2_eficiencia", "ciudadanos"),
normality_one(cit_scores$V3_digitalizacion, "V3_digitalizacion", "ciudadanos"),
normality_one(cit_scores$V4_satisfaccion, "V4_satisfaccion", "ciudadanos"),
normality_one(ciudadanos$NPS1, "NPS1", "ciudadanos")
)
write_table(normality, "normalidad")
levene_one <- function(data, outcome, group, dataset) {
complete <- complete.cases(data[[outcome]], data[[group]])
x <- suppressWarnings(as.numeric(data[[outcome]][complete]))
g <- droplevels(factor(data[[group]][complete]))
counts <- table(g)
if (length(counts) < 2 || any(counts < 2)) {
return(data.frame(dataset = dataset, dependiente = outcome, agrupacion = group,
grupos = length(counts), prueba = "Levene",
p_value = NA, decision = "No estimable: menos de 2 observaciones por grupo"))
}
test <- car::leveneTest(x ~ g)
p <- test[1, "Pr(>F)"]
data.frame(dataset = dataset, dependiente = outcome, agrupacion = group,
grupos = length(counts), prueba = "Levene", p_value = p,
decision = ifelse(p < .05, "Varianzas diferentes", "Homocedasticidad no rechazada"))
}
group_vars_func <- c("antiguedad", "relacion_tecnologia", "area")
group_vars_cit <- c("canal", "frecuencia_uso", "rango_edad", "tipo_tramite")
levene <- do.call(rbind, c(
lapply(group_vars_func, function(g) levene_one(data.frame(outcome = func_scores$V1_global,
group = funcionarios[[g]]),
"outcome", "group", "funcionarios")),
lapply(group_vars_cit, function(g) {
do.call(rbind, lapply(c("V2_eficiencia", "V3_digitalizacion", "V4_satisfaccion"),
function(y) levene_one(data.frame(outcome = cit_scores[[y]],
group = ciudadanos[[g]]),
"outcome", "group", "ciudadanos")))
})
))
levene$agrupacion <- c(rep(group_vars_func, 1), rep(NA, 0))
# Reasignación de nombres legibles: levene_one recibe columnas homogéneas para
# la fórmula, por lo que se conserva el nombre original aquí.
levene$agrupacion <- c(group_vars_func, rep(group_vars_cit, each = 3))
levene$dependiente <- c(rep("V1_global", length(group_vars_func)),
rep(c("V2_eficiencia", "V3_digitalizacion", "V4_satisfaccion"),
times = length(group_vars_cit)))
write_table(levene, "levene")
###############################################################################
# Fase 3. Hipótesis principal: V3 y V2
###############################################################################
correlation_main <- function(x, y) {
complete <- complete.cases(x, y)
x <- x[complete]; y <- y[complete]
n <- length(x)
nx <- normality_one(x, "V2_eficiencia", "ciudadanos")
ny <- normality_one(y, "V3_digitalizacion", "ciudadanos")
method <- if (n >= 3 && nx$p_value > .05 && ny$p_value > .05) "pearson" else "spearman"
test <- tryCatch(stats::cor.test(x, y, method = method, exact = FALSE),
error = function(e) NULL)
if (is.null(test)) return(data.frame(hipotesis = "H1_V3_V2", n = n, metodo = method,
estimador = NA, p_value = NA, efecto = NA,
decision = "No estimable"))
r <- unname(test$estimate); p <- test$p.value
data.frame(hipotesis = "H1_V3_V2", n = n, metodo = method,
estimador = r, p_value = p, efecto = abs(r),
decision = ifelse(p < .05, "Se rechaza H0", "No se rechaza H0"),
interpretacion = ifelse(abs(r) < .20, "Muy débil",
ifelse(abs(r) < .40, "Débil",
ifelse(abs(r) < .60, "Moderada",
ifelse(abs(r) < .80, "Fuerte", "Muy fuerte")))))
}
hypothesis <- correlation_main(cit_scores$V3_digitalizacion,
cit_scores$V2_eficiencia)
write_table(hypothesis, "hipotesis_principal_V3_V2")
###############################################################################
# Fase 3. Comparaciones por grupos, solo cuando son estimables
###############################################################################
cohen_d <- function(x, g) {
levels_g <- levels(g)
a <- x[g == levels_g[1]]; b <- x[g == levels_g[2]]
pooled <- sqrt(((length(a) - 1) * var(a) + (length(b) - 1) * var(b)) /
(length(a) + length(b) - 2))
if (is.na(pooled) || pooled == 0) return(NA_real_)
(mean(a) - mean(b)) / pooled
}
group_comparison_one <- function(data, outcome, group, dataset) {
keep <- complete.cases(data[[outcome]], data[[group]])
y <- suppressWarnings(as.numeric(data[[outcome]][keep]))
g <- droplevels(factor(data[[group]][keep]))
counts <- table(g)
if (length(counts) < 2 || any(counts < 2)) return(NULL)
lev <- car::leveneTest(y ~ g)[1, "Pr(>F)"]
equal_var <- !is.na(lev) && lev >= .05
if (length(counts) == 2) {
test <- stats::t.test(y ~ g, var.equal = equal_var)
d <- cohen_d(y, g)
data.frame(dataset = dataset, dependiente = outcome, agrupacion = group,
grupos = 2, prueba = ifelse(equal_var, "t de Student", "t de Welch"),
n = length(y), estadistico = unname(test$statistic), gl = unname(test$parameter),
p_value = test$p.value, efecto = d, tipo_efecto = "d de Cohen",
homocedasticidad = equal_var,
decision = ifelse(test$p.value < .05, "Se rechaza H0", "No se rechaza H0"),
stringsAsFactors = FALSE)
} else {
if (equal_var) {
fit <- stats::aov(y ~ g)
anova_row <- summary(fit)[[1]][1, ]
ss_between <- anova_row[["Sum Sq"]]
ss_total <- sum((y - mean(y))^2)
eta2 <- ss_between / ss_total
p <- anova_row[["Pr(>F)"]]
statistic <- anova_row[["F value"]]
df_num <- anova_row[["Df"]]
method <- "ANOVA de un factor"
} else {
fit <- stats::oneway.test(y ~ g, var.equal = FALSE)
p <- fit$p.value; statistic <- unname(fit$statistic); df_num <- unname(fit$parameter[1])
eta2 <- NA_real_; method <- "ANOVA de Welch"
}
data.frame(dataset = dataset, dependiente = outcome, agrupacion = group,
grupos = length(counts), prueba = method, n = length(y),
estadistico = statistic, gl = df_num, p_value = p, efecto = eta2,
tipo_efecto = ifelse(equal_var, "eta2", "eta2 no estimado para Welch"),
homocedasticidad = equal_var,
decision = ifelse(p < .05, "Se rechaza H0", "No se rechaza H0"),
stringsAsFactors = FALSE)
}
}
comparisons <- do.call(rbind, c(
lapply(group_vars_func, function(g) group_comparison_one(data.frame(V1_global = func_scores$V1_global,
group = funcionarios[[g]]),
"V1_global", "group", "funcionarios")),
lapply(group_vars_cit, function(g) {
do.call(rbind, lapply(c("V2_eficiencia", "V3_digitalizacion", "V4_satisfaccion"),
function(y) group_comparison_one(data.frame(outcome = cit_scores[[y]],
group = ciudadanos[[g]]),
"outcome", "group", "ciudadanos")))
})
))
if (is.null(comparisons)) {
comparisons <- data.frame(nota = "No hubo comparaciones estimables con los datos actuales")
}
write_table(comparisons, "comparaciones_grupos")
###############################################################################
# NPS y revisión documental
###############################################################################
nps_values <- suppressWarnings(as.numeric(ciudadanos$NPS1))
nps_values <- nps_values[is.finite(nps_values)]
nps_categories <- ifelse(nps_values >= 9, "Promotor",
ifelse(nps_values >= 7, "Pasivo", "Detractor"))
nps_summary <- data.frame(
indicador = c("N", "Media", "DE", "Promotores", "Pasivos", "Detractores", "NPS"),
valor = c(length(nps_values), mean(nps_values), sd(nps_values),
sum(nps_categories == "Promotor"), sum(nps_categories == "Pasivo"),
sum(nps_categories == "Detractor"),
(sum(nps_categories == "Promotor") - sum(nps_categories == "Detractor")) /
length(nps_categories) * 100))
write_table(nps_summary, "NPS")
rd_value <- function(x, value) {
key <- toupper(trimws(as.character(x)))
if (value == "cumple") return(sum(key == "1", na.rm = TRUE))
if (value == "no_cumple") return(sum(key == "0", na.rm = TRUE))
if (value == "no_aplica") return(sum(key %in% c("NA", "N/A", "N_A"), na.rm = TRUE))
sum(key %in% c("NV", "N/V", "N_V"), na.rm = TRUE)
}
documentary_criteria <- do.call(rbind, lapply(RD, function(item) {
x <- documental[[item]]
data.frame(criterio = item, cumple = rd_value(x, "cumple"),
no_cumple = rd_value(x, "no_cumple"), no_aplica = rd_value(x, "no_aplica"),
no_verificable = rd_value(x, "no_verificable"), total = length(x))
}))
write_table(documentary_criteria, "documental_criterios")
write_table(frequency_table(documental, "digital_level", "documental"),
"documental_niveles")
